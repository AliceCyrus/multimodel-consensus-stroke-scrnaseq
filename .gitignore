# ============================================================================
# .gitignore - multimodel-consensus-stroke-scrnaseq
# ============================================================================

# ---------------------------------------------------------------- Raw data
# GSE174574 10x matrices are downloaded, never committed (~251 MB).
StrokeData/*/*.gz
StrokeData/*/*.mtx
StrokeData/*/*.tsv
!StrokeData/*/.gitkeep
data/raw/
*.tar
*.tar.gz

# --------------------------------------------- Large intermediate matrices
# Regenerated by DP_Diff_Test_Train.R (~48 MB combined).
stroke_pca_train.csv
stroke_pca_test.csv

# ------------------------------------------------- Model weights / pickles
# Regenerated by training; also unsafe to load from untrusted sources.
model_checkpoints/
*.pt
*.pth
*.pkl
*.h5
*.keras
*.joblib

# ------------------------------------------------------------------ Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ----------------------------------------------------------------------- R
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ------------------------------------------------------------------- Tools
.vscode/
.idea/
*.swp

# ---------------------------------------------------------------------- OS
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------- Manuscript
# The paper source is kept locally and distributed via the preprint server,
# not from this repository. See the Citation section of README.md.
manuscript/

# ------------------------------------------------------------------- Temp
*.tmp
*.bak
*.log
*.zip
